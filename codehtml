<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chat</title>
<style id="base-css">
  :root { box-sizing: border-box; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
  html { scroll-padding-top: env(safe-area-inset-top, 0px); }
  *, *::before, *::after { box-sizing: border-box; }
  html, body { height: 100%; margin: 0; }
  body { background: var(--bg); color: var(--texto); font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; font-size: 15px; line-height: 1.55; overflow: hidden; }
  button { font: inherit; color: inherit; cursor: pointer; }

  .app { display: flex; height: 100%; }

  /* Sidebar */
  .sidebar { width: 272px; flex-shrink: 0; background: var(--painel); border-right: 1px solid var(--borda); display: flex; flex-direction: column; padding: 12px; gap: 10px; transition: transform .25s ease; }
  .brand { display: flex; align-items: center; gap: 10px; padding: 6px 6px 4px; }
  .logo { width: 32px; height: 32px; border-radius: 10px; background: var(--destaque); color: var(--destaqueTexto); display: grid; place-items: center; font-weight: 700; font-size: 15px; flex-shrink: 0; }
  .brand b { font-size: 16px; }
  .brand small { display: block; color: var(--suave); font-size: 12px; margin-top: -2px; }
  .btn-new { display: flex; align-items: center; gap: 8px; width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--borda); background: var(--bg); text-align: left; font-weight: 500; }
  .btn-new:hover { border-color: var(--destaque); }
  .list { flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 2px; margin: 0 -4px; padding: 0 4px; }
  .list-label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--suave); padding: 8px 8px 4px; }
  .item { display: flex; align-items: center; gap: 6px; padding: 9px 10px; border-radius: 9px; cursor: pointer; }
  .item:hover { background: var(--hover); }
  .item.ativo { background: var(--hover); font-weight: 600; }
  .item span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .item .del { opacity: 0; border: 0; background: none; color: var(--suave); padding: 2px 6px; border-radius: 6px; }
  .item:hover .del, .item.ativo .del { opacity: 1; }
  .item .del:hover { color: var(--texto); background: var(--borda); }
  .aviso { font-size: 12px; color: var(--suave); padding: 8px 6px 2px; border-top: 1px solid var(--borda); }
  .side-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .icon-btn { border: 1px solid var(--borda); background: var(--bg); width: 34px; height: 34px; border-radius: 9px; display: grid; place-items: center; flex-shrink: 0; }
  .icon-btn:hover { border-color: var(--destaque); }

  /* Main */
  .main { flex: 1; min-width: 0; display: flex; flex-direction: column; height: 100%; }
  .topbar { display: none; align-items: center; gap: 10px; padding: 10px 12px; border-bottom: 1px solid var(--borda); background: var(--painel); }
  .topbar b { font-size: 15px; }
  .chat { flex: 1; overflow-y: auto; padding: 24px 16px 8px; scroll-behavior: smooth; }
  .col { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 18px; min-height: 100%; }
  .col > .vazio { flex: 1; }

  .msg { display: flex; gap: 12px; animation: subir .25s ease; }
  .msg.user { justify-content: flex-end; }
  .avatar { width: 30px; height: 30px; border-radius: 9px; background: var(--destaque); color: var(--destaqueTexto); display: grid; place-items: center; font-weight: 700; font-size: 13px; flex-shrink: 0; margin-top: 2px; }
  .bubble { max-width: 100%; }
  .msg.user .bubble { background: var(--balaoUsuario); color: var(--balaoUsuarioTexto); padding: 10px 15px; border-radius: 18px 18px 4px 18px; max-width: 80%; white-space: pre-wrap; overflow-wrap: anywhere; }
  .msg.bot .bubble { flex: 1; min-width: 0; }
  .msg.bot .txt { white-space: pre-wrap; overflow-wrap: anywhere; }
  .fonte { margin-top: 8px; font-size: 12px; color: var(--fonte); line-height: 1.4; }
  .fonte::before { content: "↳ "; opacity: .7; }

  .typing { display: inline-flex; gap: 4px; padding: 8px 0; }
  .typing i { width: 7px; height: 7px; border-radius: 50%; background: var(--suave); animation: pulso 1s infinite ease-in-out; }
  .typing i:nth-child(2) { animation-delay: .15s; }
  .typing i:nth-child(3) { animation-delay: .3s; }

  .vazio { min-height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 14px; padding: 20px 0 60px; }
  .vazio .logo { width: 52px; height: 52px; font-size: 24px; border-radius: 16px; }
  .vazio h1 { margin: 0; font-size: 26px; font-weight: 650; }
  .vazio p { margin: 0; color: var(--suave); max-width: 460px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 6px; }
  .chip { border: 1px solid var(--borda); background: var(--painel); padding: 8px 14px; border-radius: 999px; font-size: 14px; }
  .chip:hover { border-color: var(--destaque); }

  /* Composer */
  .composer { padding: 8px 16px 14px; }
  .box { max-width: 760px; margin: 0 auto; background: var(--painel); border: 1px solid var(--borda); border-radius: 18px; padding: 8px 8px 8px 16px; display: flex; align-items: flex-end; gap: 8px; }
  .box:focus-within { border-color: var(--destaque); }
  textarea { flex: 1; border: 0; outline: 0; background: transparent; color: var(--texto); font: inherit; resize: none; max-height: 160px; padding: 8px 0; line-height: 1.45; }
  textarea::placeholder { color: var(--suave); }
  .send { width: 38px; height: 38px; border-radius: 12px; border: 0; background: var(--destaque); color: var(--destaqueTexto); display: grid; place-items: center; flex-shrink: 0; }
  .send:disabled { opacity: .35; cursor: default; }
  .tom { max-width: 760px; margin: 8px auto 0; display: flex; align-items: center; justify-content: center; gap: 6px; font-size: 12px; color: var(--suave); flex-wrap: wrap; }
  .tom button { border: 1px solid var(--borda); background: transparent; color: var(--suave); padding: 2px 10px; border-radius: 999px; font-size: 12px; }
  .tom button.on { background: var(--destaque); border-color: var(--destaque); color: var(--destaqueTexto); }

  .overlay { display: none; }

  @keyframes subir { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes pulso { 0%, 80%, 100% { opacity: .3; transform: scale(.85); } 40% { opacity: 1; transform: scale(1); } }

  @media (max-width: 760px) {
    .sidebar { position: fixed; z-index: 20; top: 0; bottom: 0; left: 0; transform: translateX(-100%); padding-top: calc(12px + env(safe-area-inset-top, 0px)); }
    .sidebar.aberta { transform: none; box-shadow: 0 0 40px rgba(0,0,0,.35); }
    .overlay.on { display: block; position: fixed; inset: 0; background: rgba(0,0,0,.4); z-index: 10; }
    .topbar { display: flex; }
    .msg.user .bubble { max-width: 90%; }
  }
</style>
</head>
