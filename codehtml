    assunto: "Venezuela - Investimento do PIB em educação pública",
    texto: "O investimento público em educação na Venezuela tornou-se de difícil aferição sistemática oficial detalhada, estimado em patamares variáveis de 3% a 5% do PIB nominal reduzido.",
    keywords: ["pib investido na educacao na Venezuela", "pib investido na educação na Venezuela", "quanto do pib e investido em educacao publica na Venezuela", "quanto do pib é investido em educação pública na Venezuela"],
    fonte: "Toda Matéria"
  },
  {
    assunto: "Venezuela - Evasão escolar e distorção idade-série",
    texto: "A evasão escolar e a distorção idade-série agravaram-se devido a crises socioeconômicas e êxodo docente/estudantil.",
    keywords: ["taxa de evasao na Venezuela", "taxa de evasão na Venezuela", "taxa de evasao escolar na Venezuela", "taxa de evasão escolar na Venezuela", "evasao escolar na Venezuela", "evasão escolar na Venezuela"],
    fonte: "Brasil Escola"
  },
  {
    assunto: "Venezuela - Posicionamento em avaliações globais (PISA)",
    texto: "A Venezuela não participa de forma regular e sistêmica do PISA da OCDE ou avaliações internacionais abertas recentes.",
    keywords: ["avaliacoes globais da Venezuela", "avaliações globais da Venezuela"],
    fonte: "Wikipedia"
  },
  {
    assunto: "Café",
    texto: "O café é uma das bebidas mais consumidas do mundo, feita a partir das sementes torradas do cafeeiro. Uma lenda popular conta que ele foi descoberto na Etiópia, quando um pastor notou suas cabras agitadas depois de comer os frutos da planta.\n\nO Brasil é o maior produtor mundial do grão. As duas espécies mais comuns são a arábica, mais doce e aromática, e a robusta, mais amarga e com mais cafeína.",
    keywords: ["cafe", "cafeina", "arabica", "robusta", "grao", "cafeeiro", "expresso"],
    fonte: "Exemplo — troque pela sua fonte (livro, artigo, link)"
  },
  {
    assunto: "Como editar esta base",
    texto: "Toda a base fica dentro do código, na lista chamada ARTIGOS. Cada artigo tem quatro campos: assunto, texto, keywords e fonte.\n\nPara adicionar um novo, copie um bloco inteiro, cole logo depois e troque o conteúdo. Quanto mais palavras-chave você colocar (sem acento e em minúsculas), mais fácil eu encontro o artigo certo. O nome e as cores ficam no bloco CONFIG, no topo.",
    keywords: ["editar", "adicionar artigo", "base", "configurar", "personalizar", "cores", "paleta", "nome do assistente", "como funciona"],
    fonte: "Instruções internas deste chat"
  },


];

/* ══════════════════════════════════════════════════════════════
   3) FRASES — o jeito de falar (informal ↔ formal). Pode editar.
      {assunto} vira o nome do artigo · {nome} vira o nome do assistente
   ══════════════════════════════════════════════════════════════ */
const FALAS = {
  informal: {
    intro: ["Boa pergunta! Olha só:", "Ah, essa eu sei! Bora lá:", "Então, sobre {assunto}:", "Deixa eu te explicar:", "Opa, tenho algo sobre isso!", "Vou te contar o que eu sei:", "Beleza, é o seguinte:"],
    fecho: ["Quer que eu aprofunde?", "Ficou alguma dúvida? Pode mandar!", "Se quiser saber mais, é só falar.", "", ""],
    outro: ["Ah, e também tenho coisa sobre {x}, se rolar interesse.", "Tenho algo sobre {x} também, se quiser dar uma olhada."],
    ola: ["Oi! Tudo bem? Sobre o que você quer saber?", "E aí! Manda sua pergunta.", "Opa, e aí? Como posso ajudar?"],
    valeu: ["Por nada! Qualquer coisa é só chamar.", "Tamo junto! Volta sempre.", "Imagina, foi um prazer!"],
    tchau: ["Até mais! 👋", "Falou! Volta quando quiser.", "Tchau, tchau! Até a próxima."],
    quem: ["Opa, cumpade, Sou {nome}, um robozin que responde com base nas fofocas que sei, kkkk. Pergunta aí!", "Me chamo {nome}! Respondo sobre os assuntos da minha base e sempre mostro de onde tirei a informação."],
    naoSei: ["Hmm, sobre isso eu não tenho nada guardado ainda. 😅", "Essa eu não sei, viu? Não achei nada na minha base.", "Poxa, não tenho esta informação. Talvez tenta com outras palavras?"],
    sugere: "Mas posso te falar sobre: {lista}.",
    temas: "Tenho material sobre: {lista}. Escolhe um!"
  },
  formal: {
    intro: ["Com prazer. Segue a informação:", "De acordo com o material disponível, sobre {assunto}:", "Certamente. Vejamos:", "Conforme consta na base de artigos:", "Segue o que há registrado a respeito:", "Claro. Em relação a {assunto}:"],
    fecho: ["Fico à disposição para esclarecer outros pontos.", "Caso deseje mais detalhes, basta solicitar.", "Posso complementar, se necessário.", "", ""],
    outro: ["Adicionalmente, há material sobre {x}.", "Também dispomos de conteúdo sobre {x}, caso seja de interesse."],
    ola: ["Olá! Como posso ajudá-lo(a) hoje?", "Olá, seja bem-vindo(a). Sobre qual assunto deseja saber?", "Saudações. Em que posso ser útil?"],
    valeu: ["Disponha. Fico à inteira disposição.", "Agradeço a interação. Estarei aqui caso precise.", "Foi um prazer auxiliar."],
    tchau: ["Até logo. Tenha um excelente dia.", "Agradeço o contato. Até a próxima.", "Encerro por aqui. Estou à disposição sempre que necessário."],
    quem: ["Sou {nome}, um assistente que responde com base em uma coleção de artigos e sempre informa a fonte utilizada.", "Meu nome é {nome}. Minhas respostas se baseiam nos artigos cadastrados, com a devida indicação das fontes."],
    naoSei: ["Lamento, mas não encontrei informações sobre esse tema na base disponível.", "Não há, até o momento, conteúdo cadastrado a respeito. Poderia reformular a pergunta?", "Infelizmente não localizei material relacionado à sua consulta."],
    sugere: "Posso, contudo, abordar: {lista}.",
    temas: ["Os assuntos disponíveis são: {lista}.", "eu já sei: {lista}. ",]
  }
};

/* ══════════════════════════════════════════════════════════════
   4) MOTOR — daqui pra baixo não precisa mexer
   ══════════════════════════════════════════════════════════════ */
(function aplicarTema() {
  const vars = o => Object.entries(o).map(([k, v]) => `--${k}:${v};`).join("");
  const s = document.createElement("style");
  s.textContent =
    `:root{${vars(CONFIG.cores.claro)}}` +
    `@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){${vars(CONFIG.cores.escuro)}}}` +
    `:root[data-theme="dark"]{${vars(CONFIG.cores.escuro)}}` +
    `:root[data-theme="light"]{${vars(CONFIG.cores.claro)}}`;
  document.head.appendChild(s);
  document.title = CONFIG.nome;
  const fav = document.createElement("link");
  fav.rel = "icon";
  fav.href = "data:image/svg+xml," + encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">${CONFIG.favicon}</text></svg>`);
  document.head.appendChild(fav);
})();

const $ = id => document.getElementById(id);
$("logoSide").textContent = CONFIG.inicial;
$("nomeSide").textContent = CONFIG.nome;
$("subSide").textContent = CONFIG.subtitulo;
$("nomeTop").textContent = CONFIG.nome;
$("entrada").placeholder = CONFIG.placeholder;

/* ---------- Busca ---------- */
const norm = s => String(s).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9\s]/g, " ").replace(/\s+/g, " ").trim();
const STOP = new Set("o a os as um uma uns umas de do da dos das em no na nos nas por para pra com sem sobre e ou que qual quais como quem onde quando porque me te se eu voce vc tu ele ela nos eles elas meu minha seu sua isso isto essa esse aquilo aqui ali la ser estar ter foi sao era tem tenho fala falar diz dizer explica explicar conta contar quero queria gostaria saber mais pode poderia favor ai oi ola mim algo alguma qualquer coisa fale me".split(" "));
const stem = w => (w.length > 4 ? w.replace(/(es|s)$/, "") : w);
const tokens = s => norm(s).split(" ").filter(w => w.length > 1 && !STOP.has(w)).map(stem);

const INDEX = ARTIGOS.map(a => ({
  a,
  kws: a.keywords.map(norm),
  nome: tokens(a.assunto),
  texto: new Set(tokens(a.texto))
}));

function buscar(q) {
  const nq = norm(q), padded = " " + nq + " ", tk = tokens(q), tset = new Set(tk);
  const res = INDEX.map(it => {
    let s = 0;
    it.kws.forEach(k => {
      if (padded.includes(" " + k + " ")) s += 4;
      else {
        const ws = k.split(" ").map(stem);
        if (ws.length === 1) { if (tset.has(ws[0])) s += 3; }
        else s += ws.filter(w => tset.has(w) && !STOP.has(w)).length;
      }
    });
    it.nome.forEach(w => { if (tset.has(w)) s += 2; });
    let t = 0; tk.forEach(w => { if (it.texto.has(w)) t += 0.5; });
    s += Math.min(t, 2);
    return { a: it.a, s };
  }).filter(r => r.s >= 2.5).sort((x, y) => y.s - x.s);
  return res;
}

/* ---------- Tom de voz ---------- */
let tomEscolhido = CONFIG.tomInicial;
const INFORMAL_RX = /\b(oi+|opa|e ai|eai|vc|vcs|blz|kk+|rs+|pq|tb|tmb|mano|cara|valeu|to|ta|pra|ne|bora|fala|flw|vlw|tipo)\b/;
const FORMAL_RX = /(prezad|gostaria|poderia|por favor|senhor|cordialmente|agradec|solicito|bom dia|boa tarde|boa noite)/;

function escolherTom(convo, msg) {
  if (tomEscolhido !== "auto") return tomEscolhido;
  const n = norm(msg);
  if (INFORMAL_RX.test(n) && !FORMAL_RX.test(n)) return (convo.tom = "informal");
  if (FORMAL_RX.test(n)) return (convo.tom = "formal");
  if (convo.tom && Math.random() < 0.6) return convo.tom;
  return (convo.tom = Math.random() < 0.5 ? "informal" : "formal");
}

const ultimos = {};
function pick(tom, chave, vars = {}) {
  const lista = FALAS[tom][chave];
  if (typeof lista === "string") return fill(lista, vars);
  let f = lista[Math.floor(Math.random() * lista.length)];
  if (lista.length > 1 && ultimos[tom + chave] === f) f = lista[(lista.indexOf(f) + 1) % lista.length];
  ultimos[tom + chave] = f;
  return fill(f, vars);
}
function fill(t, v) {
  return t.replace(/\{(\w+)\}/g, (_, k) => (k === "nome" ? CONFIG.nome : v[k] ?? ""));
}
const listar = arr => arr.length < 2 ? arr.join("") : arr.slice(0, -1).join(", ") + " e " + arr[arr.length - 1];
const todosAssuntos = () => listar(ARTIGOS.map(a => a.assunto));

/* ---------- Gerar resposta ---------- */
function responder(convo, pergunta) {
  const tom = escolherTom(convo, pergunta);
  const n = norm(pergunta);
  const res = buscar(pergunta);

  if (!res.length) {
    if (/^(oi+|ola|opa|e ai|eai|fala|hey|hello|bom dia|boa tarde|boa noite|salve)\b/.test(n) && n.split(" ").length <= 5) return { text: pick(tom, "ola") };
    if (/(obrigad|valeu|vlw|agradec|thanks)/.test(n)) return { text: pick(tom, "valeu") };
    if (/^(tchau|ate mais|ate logo|flw|falou|adeus)/.test(n)) return { text: pick(tom, "tchau") };
    if (/(quem (e|eh) voce|quem e vc|seu nome|se chama|quem es)/.test(n)) return { text: pick(tom, "quem") };
    if (/(assuntos|temas|topicos|o que voce (sabe|tem)|o que vc sabe|ajuda|o que posso)/.test(n)) return { text: pick(tom, "temas", { lista: todosAssuntos() }) };
    return { text: pick(tom, "naoSei") + "\n\n" + pick(tom, "sugere", { lista: todosAssuntos() }) };
  }
  const top = res[0];
  let partes = [pick(tom, "intro", { assunto: top.a.assunto.toLowerCase() }), top.a.texto];
  const segundo = res[1];
  if (segundo && segundo.s >= top.s * 0.6) partes.push(pick(tom, "outro", { x: segundo.a.assunto }));
  else {
    const f = pick(tom, "fecho");
    if (f) partes.push(f);
  }
  return { text: partes.join("\n\n"), fonte: top.a.fonte };
}
/* ---------- Estado (só em memória) ---------- */
let convos = [];
let ativaId = null;
let contador = 0;
const ocupadas = new Set();
const ativa = () => convos.find(c => c.id === ativaId);
function novaConversa() {
  const c = { id: ++contador, titulo: "Nova conversa", msgs: [], tom: null };
  convos.unshift(c);
  ativaId = c.id;
  renderTudo();
  fecharMenu();
  $("entrada").focus();
}
function removerConversa(id) {
  convos = convos.filter(c => c.id !== id);
  if (ativaId === id) ativaId = convos.length ? convos[0].id : null;
  if (!convos.length) return novaConversa();
  renderTudo();
}
/* ---------- Render ---------- */
function renderLista() {
  const el = $("lista");
  el.innerHTML = "";
  convos.forEach(c => {
    const d = document.createElement("div");
    d.className = "item" + (c.id === ativaId ? " ativo" : "");
    const s = document.createElement("span"); s.textContent = c.titulo;
    const x = document.createElement("button"); x.className = "del"; x.textContent = "✕"; x.title = "Apagar";
    x.onclick = e => { e.stopPropagation(); removerConversa(c.id); };
    d.onclick = () => { ativaId = c.id; renderTudo(); fecharMenu(); };
    d.append(s, x);
    el.appendChild(d);
  });
}
function criarMsgBot(text, fonte) {
  const m = document.createElement("div");
  m.className = "msg bot";
  m.innerHTML = `<div class="avatar"></div><div class="bubble"><div class="txt"></div></div>`;
  m.querySelector(".avatar").textContent = CONFIG.inicial;
  m.querySelector(".txt").textContent = text;
  if (fonte) addFonte(m, fonte);
  return m;
}
function addFonte(m, fonte) {
  const f = document.createElement("div");
  f.className = "fonte";
  f.textContent = "Fonte: " + fonte;
  m.querySelector(".bubble").appendChild(f);
}
function criarMsgUser(text) {
  const m = document.createElement("div");
  m.className = "msg user";
  const b = document.createElement("div"); b.className = "bubble"; b.textContent = text;
  m.appendChild(b);
  return m;
}
function renderChat() {
  const col = $("col");
  col.innerHTML = "";
  const c = ativa();
  if (!c) return;
  if (!c.msgs.length) {
    const v = document.createElement("div");
    v.className = "vazio";
    v.innerHTML = `<div class="logo"></div><h1></h1><p></p><div class="chips"></div>`;
    v.querySelector(".logo").textContent = CONFIG.inicial;
    v.querySelector("h1").textContent = "Olá, eu sou " + CONFIG.nome;
    v.querySelector("p").textContent = CONFIG.boasVindas;
    const chips = v.querySelector(".chips");
    [...ARTIGOS].sort(() => Math.random() - 0.5).slice(0, 4).forEach(a => {
      const b = document.createElement("button");
      b.className = "chip";
      b.textContent = a.assunto;
      b.onclick = () => enviar("Me fala sobre " + a.assunto.toLowerCase());
      chips.appendChild(b);
    });
    col.appendChild(v);
    return;
  }
  c.msgs.forEach(m => col.appendChild(m.role === "user" ? criarMsgUser(m.text) : criarMsgBot(m.text, m.fonte)));
  if (ocupadas.has(c.id)) col.appendChild(digitando());
  rolar(false);
}
function digitando() {
  const m = document.createElement("div");
  m.className = "msg bot"; m.id = "digitando";
  m.innerHTML = `<div class="avatar"></div><div class="bubble"><div class="typing"><i></i><i></i><i></i></div></div>`;
  m.querySelector(".avatar").textContent = CONFIG.inicial;
  return m;
}
function renderTudo() { renderLista(); renderChat(); atualizarBotao(); }
function rolar(suave = true) {
  const ch = $("chat");
  ch.style.scrollBehavior = suave ? "smooth" : "auto";
  ch.scrollTop = ch.scrollHeight;
}
/* ---------- Envio ---------- */
function enviar(texto) {
  const c = ativa();
  const q = (texto ?? $("entrada").value).trim();
  if (!c || !q || ocupadas.has(c.id)) return;
  $("entrada").value = "";
  autoAltura();
  if (!c.msgs.length) c.titulo = q.length > 34 ? q.slice(0, 34) + "…" : q;
  c.msgs.push({ role: "user", text: q });
  ocupadas.add(c.id);
  renderTudo();
  const [mn, mx] = CONFIG.tempoDigitando;
  const espera = mn + Math.random() * (mx - mn);
  setTimeout(() => {
    const r = responder(c, q);
    c.msgs.push({ role: "bot", text: r.text, fonte: r.fonte });
    ocupadas.delete(c.id);
    if (ativaId !== c.id) { renderLista(); atualizarBotao(); return; }
    $("digitando")?.remove();
    const el = criarMsgBot("", null);
    $("col").appendChild(el);
    atualizarBotao();
    transmitir(el, r.text, r.fonte);
  }, espera);
}
function transmitir(el, texto, fonte) {
  const alvo = el.querySelector(".txt");
  const partes = texto.split(/(\s+)/);
  let i = 0;
  const t = setInterval(() => {
    i += 3;
    alvo.textContent = partes.slice(0, i).join("");
    rolar(false);
    if (i >= partes.length) {
      clearInterval(t);
      alvo.textContent = texto;
      if (fonte) addFonte(el, fonte);
      rolar();
    }
  }, 28);
}
/* ---------- UI ---------- */
function atualizarBotao() {
  const c = ativa();
  $("btnEnviar").disabled = !$("entrada").value.trim() || (c && ocupadas.has(c.id));
}
function autoAltura() {
  const t = $("entrada");
  t.style.height = "auto";
  t.style.height = Math.min(t.scrollHeight, 160) + "px";
}
$("entrada").addEventListener("input", () => { autoAltura(); atualizarBotao(); });
$("entrada").addEventListener("keydown", e => {
  if (e.key === "Enter" && !e.shiftKey && !e.isComposing) { e.preventDefault(); enviar(); }
});
$("btnEnviar").onclick = () => enviar();
$("btnNova").onclick = novaConversa;
function abrirMenu() { $("sidebar").classList.add("aberta"); $("overlay").classList.add("on"); }
function fecharMenu() { $("sidebar").classList.remove("aberta"); $("overlay").classList.remove("on"); }
$("btnMenu").onclick = abrirMenu;
$("overlay").onclick = fecharMenu;
$("btnTema").onclick = () => {
  const r = document.documentElement;
  const escuroAgora = r.dataset.theme ? r.dataset.theme === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
  r.dataset.theme = escuroAgora ? "light" : "dark";
};
document.querySelectorAll("#tomBar button").forEach(b => {
  b.onclick = () => {
    tomEscolhido = b.dataset.tom;
    document.querySelectorAll("#tomBar button").forEach(x => x.classList.toggle("on", x === b));
  };
  if (b.dataset.tom === tomEscolhido) b.classList.add("on");
});
novaConversa();
</script>
